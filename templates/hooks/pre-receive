#!/usr/bin/env bash
# pre-receive - canonical push policy for a homelab bare repository.
#
# Contract:
#   - .env.example / backend/.env.example are PERMITTED.
#   - .env* secrets are BLOCKED in every branch (only names ending in
#     exactly ".example" are permitted).
#   - 'main' cannot be deleted.
#   - Non-main branches are otherwise accepted normally.
#   - If DEPLOY_USER is configured, updates to main must come from that user.
#   - If GLOBAL_PRE_RECEIVE is configured and executable, it is chained
#     (stdin is preserved).

set -euo pipefail

ZERO="0000000000000000000000000000000000000000"

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HOOK_CONFIG="$HOOK_DIR/config"

DEPLOY_USER=""
DEPLOY_BRANCH="main"
GLOBAL_PRE_RECEIVE=""

if [ -f "$HOOK_CONFIG" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      DEPLOY_USER=*)        DEPLOY_USER="${line#*=}" ;;
      DEPLOY_BRANCH=*)      DEPLOY_BRANCH="${line#*=}" ;;
      GLOBAL_PRE_RECEIVE=*) GLOBAL_PRE_RECEIVE="${line#*=}" ;;
    esac
  done < "$HOOK_CONFIG"
fi

is_env_secret() {
  local base="${1##*/}"
  case "$base" in
    .env) return 0 ;;
    .env.*)
      case "$base" in
        *.example) return 1 ;;
        *)         return 0 ;;
      esac ;;
    *) return 1 ;;
  esac
}

# Capture stdin once so it can be replayed to a chained global hook.
INPUT="$(cat)"

DIFF_TMP="$(mktemp)" || exit 1
trap 'rm -f "$DIFF_TMP"' EXIT

while read -r oldrev newrev refname; do
  [ -n "$oldrev" ] || continue
  [ -n "$newrev" ] || continue

  if [ "$refname" = "refs/heads/$DEPLOY_BRANCH" ] && [ "$newrev" = "$ZERO" ]; then
    echo "error: deletion of '$DEPLOY_BRANCH' is not allowed" >&2
    exit 1
  fi

  if [ "$newrev" = "$ZERO" ]; then
    continue
  fi

  if [ -n "$DEPLOY_USER" ] && [ "$refname" = "refs/heads/$DEPLOY_BRANCH" ]; then
    if [ "$(id -un 2>/dev/null || true)" != "$DEPLOY_USER" ]; then
      echo "error: $DEPLOY_BRANCH updates must be performed by '$DEPLOY_USER'" >&2
      exit 1
    fi
  fi

  if [ "$oldrev" = "$ZERO" ]; then
    git diff-tree --root --no-commit-id --name-only -r -z "$newrev" > "$DIFF_TMP"
  else
    git diff-tree --no-commit-id --name-only -r -z "$oldrev" "$newrev" > "$DIFF_TMP"
  fi

  while IFS= read -r -d '' f; do
    if is_env_secret "$f"; then
      printf 'error: env file is not allowed in any branch: %q\n' "$f" >&2
      exit 1
    fi
  done < "$DIFF_TMP"
done <<< "$INPUT"

if [ -n "$GLOBAL_PRE_RECEIVE" ] && [ -x "$GLOBAL_PRE_RECEIVE" ]; then
  printf '%s\n' "$INPUT" | "$GLOBAL_PRE_RECEIVE" || exit $?
fi

exit 0
